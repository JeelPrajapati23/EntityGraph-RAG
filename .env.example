# Copy to .env and fill in.
# GROQ_API_KEY: generation (exploit-condition extraction, router classification, answer synthesis) — https://console.groq.com/keys
# Several comma-separated keys (each from a different Groq org) are rotated on rate limits.
# HF_TOKEN: embeddings via the Hugging Face Inference API — https://huggingface.co/settings/tokens
GROQ_API_KEY=
HF_TOKEN=
